# Application Settings
APP_NAME="Datazoic Agentic System"
APP_ENV=local
APP_SECRET_KEY=change-this-to-a-secure-random-key-in-production-32-chars
JWT_SECRET_KEY=change-this-jwt-secret-key-to-a-secure-random-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini LLM & Embedding Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Observability: LangSmith tracing (optional)
# Leave LANGSMITH_API_KEY empty to run without tracing. The per-turn stage timeline and
# the audit tables work regardless. With a key set, each pipeline node and each reasoning
# call appears as a span in the LangSmith project below.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datazoic-agentic-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Browser origins allowed to call the API (comma-separated).
# Never use "*" here: combined with credentials it lets any site use a signed-in token.
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Database (Default to local SQLite for zero-config dev; set postgresql for production)
DATABASE_URL=sqlite+aiosqlite:///./agentic_system.db
DATABASE_ECHO=false

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=tool_index
QDRANT_KNOWLEDGE_COLLECTION=knowledge_base
QDRANT_USE_MEMORY=true

# PayPal Sandbox Credentials (Optional - mock mode functions without credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Initial Local Demo Accounts (Bootstrapped securely on first run)
BOOTSTRAP_ADMIN_EMAIL=admin@examplemail.com
BOOTSTRAP_ADMIN_PASSWORD=admin@123
BOOTSTRAP_USER_EMAIL=user@examplemail.com
BOOTSTRAP_USER_PASSWORD=user@123

# Execution Engine & Agent Guardrails
DEFAULT_API_TIMEOUT=30
MAX_AGENT_ITERATIONS=10
MAX_TOOL_RETRIES=3
RETRIEVAL_TOP_K=6

# Outbound Email Delivery (Google SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password_here
SMTP_FROM=your_email@gmail.com
